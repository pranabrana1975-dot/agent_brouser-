{
  "name": "agentbrowser-workspace",
  "private": true,
  "version": "1.1.0",
  "description": "Headless browser control plane, JavaScript SDK, and MCP server for AI agents",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm --prefix agentbrowser ci",
    "start": "npm --prefix agentbrowser start",
    "mcp": "npm --prefix agentbrowser run mcp",
    "mcp:embedded": "npm --prefix agentbrowser run mcp:embedded",
    "fetch": "node agentbrowser/cli.mjs fetch",
    "test": "npm --prefix agentbrowser test",
    "test:e2e": "npm --prefix agentbrowser run test:e2e"
  },
  "license": "MIT"
}
